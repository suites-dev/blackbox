{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.suites.dev/blackbox/client-execution/v1",
  "title": "Blackbox client execution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["args", "target", "telemetry"],
  "properties": {
    "args": { "type": "array", "items": { "type": "string" } },
    "target": { "$ref": "#/$defs/target" },
    "telemetry": { "$ref": "#/$defs/telemetry" }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "host", "port", "url"],
      "properties": {
        "protocol": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "participantId", "service", "environment", "endpoint"],
          "properties": {
            "kind": { "const": "entrypoint" },
            "participantId": { "type": "string", "minLength": 1 },
            "service": { "type": "string", "minLength": 1 },
            "environment": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "endpoint": { "$ref": "#/$defs/endpoint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "participantId", "service", "environment", "endpoint"],
          "properties": {
            "kind": { "const": "participant" },
            "participantId": { "type": "string", "minLength": 1 },
            "service": { "type": "string", "minLength": 1 },
            "environment": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "endpoint": { "$ref": "#/$defs/endpoint" }
          }
        }
      ]
    },
    "telemetry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "disabled" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sessionId", "executionId", "activityId"],
          "properties": {
            "kind": { "const": "enabled" },
            "sessionId": { "type": "string", "minLength": 1 },
            "executionId": { "type": "string", "minLength": 1 },
            "activityId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
