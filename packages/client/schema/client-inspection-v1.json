{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.suites.dev/blackbox/client-inspection/v1",
  "title": "Blackbox client inspection result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "client"],
      "properties": {
        "kind": { "const": "available" },
        "client": { "$ref": "#/$defs/clientIdentity" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "error"],
      "properties": {
        "kind": { "const": "unavailable" },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  ],
  "$defs": {
    "clientIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["entrypoint", "utility"] },
        "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
