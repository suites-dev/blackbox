{
  "name": "@suites/blackbox-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authoring contract for Blackbox Capsule clients.",
  "files": [
    "dist",
    "schema"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "blackbox-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node-runner": {
      "blackbox-source": "./src/node-runner/index.ts",
      "types": "./dist/node-runner/index.d.ts",
      "import": "./dist/node-runner/index.js",
      "default": "./dist/node-runner/index.js"
    },
    "./schema/client-result-v1.json": "./schema/client-result-v1.json",
    "./schema/client-execution-v1.json": "./schema/client-execution-v1.json",
    "./schema/client-inspection-v1.json": "./schema/client-inspection-v1.json"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0"
  },
  "devDependencies": {
    "ajv": "8.18.0",
    "rimraf": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
