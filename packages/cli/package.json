{
  "name": "@suites/blackbox-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Blackbox command-line facade for Sandboxes, Testing, and Assurance.",
  "bin": {
    "blackbox": "./bin/run.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint src bin scripts",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "@suites/blackbox-catalog-internal": "workspace:*",
    "@suites/blackbox-capsule-internal": "workspace:*",
    "@suites/blackbox-driver": "workspace:*",
    "@suites/blackbox-inst-runtime-node": "workspace:*",
    "@suites/blackbox-instrumentation-internal": "workspace:*",
    "@suites/blackbox-report-server-internal": "workspace:*",
    "string-width": "4.2.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "oclif": {
    "bin": "blackbox",
    "dirname": "blackbox",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "license": "Apache-2.0"
}
