{
  "name": "@suites/blackbox-cli",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "description": "Blackbox command-line facade for Sandboxes, Testing, and Assurance.",
  "bin": {
    "blackbox": "./bin/run.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./skills": {
      "blackbox-source": "./src/skills.ts",
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "default": "./dist/skills.js"
    },
    "./skills/blackbox": {
      "blackbox-source": "./src/skills.ts",
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "default": "./dist/skills.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint src bin scripts",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@oclif/core": "^5.1.0",
    "@suites/blackbox-cli-contract": "workspace:*",
    "import-meta-resolve": "4.2.0",
    "string-width": "8.3.0"
  },
  "devDependencies": {
    "@suites/blackbox-skills": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@suites/blackbox-skills": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@suites/blackbox-skills": {
      "optional": true
    }
  },
  "blackbox": {
    "skills": {
      "apiVersion": 1,
      "export": "./skills"
    }
  },
  "oclif": {
    "bin": "blackbox",
    "dirname": "blackbox",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/command-registry.js",
      "identifier": "COMMANDS"
    },
    "hooks": {
      "prerun": "./dist/hooks/prerun.js"
    },
    "helpClass": "./dist/help.js",
    "topicSeparator": " ",
    "topics": {
      "capsule": {
        "description": "Start, drive, inspect and report on capsules."
      },
      "capsule:report": {
        "description": "Write, serve or export a capsule report."
      },
      "catalog": {
        "description": "Inspect and validate the project catalog."
      },
      "driver": {
        "description": "Install the project-owned driver runtime."
      },
      "inst": {
        "description": "Install project-local runtime instrumentation."
      }
    }
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suites-dev/blackbox.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/suites-dev/blackbox/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/suites-dev/blackbox/issues"
  },
  "author": "Suites"
}
