{
  "name": "@suites/blackbox-telemetry-analyzer-internal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure, deterministic normalization of retained OTLP telemetry into versioned effect sets.",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "blackbox-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema/effect-set-v1.json": "./dist/schema/effect-set-v1.json"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "devDependencies": {
    "@suites/blackbox-otel-collector-internal": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "8.20.0",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0"
}
