{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blackbox:skills:receipt-bundle:1",
  "title": "Blackbox receipt-bundle v1",
  "$ref": "#/$defs/receiptBundle",
  "$defs": {
    "receiptBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "provenance", "receipts"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "receipt-bundle" },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "description"],
              "properties": {
                "kind": { "const": "example" },
                "description": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "issuer"],
              "properties": {
                "kind": { "const": "runner" },
                "issuer": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/receipt" },
          "minItems": 0,
          "maxItems": 10000
        }
      }
    },
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scope",
            "artifact",
            "digest",
            "activity",
            "kind",
            "phase",
            "argv",
            "result"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "scope": { "$ref": "#/$defs/scope" },
            "artifact": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
            },
            "digest": { "type": "string", "minLength": 1, "pattern": "^[a-f0-9]{64}$" },
            "activity": { "$ref": "#/$defs/activity" },
            "kind": { "const": "command" },
            "phase": { "enum": ["catalog", "acquisition", "readiness", "setup", "stimulus"] },
            "argv": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000
            },
            "result": { "$ref": "#/$defs/processResult" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scope",
            "artifact",
            "digest",
            "activity",
            "kind",
            "claimId",
            "nodeId",
            "businessId",
            "result"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "scope": { "$ref": "#/$defs/scope" },
            "artifact": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
            },
            "digest": { "type": "string", "minLength": 1, "pattern": "^[a-f0-9]{64}$" },
            "activity": { "$ref": "#/$defs/activity" },
            "kind": { "const": "terminal" },
            "claimId": { "type": "string", "minLength": 1 },
            "nodeId": { "type": "string", "minLength": 1 },
            "businessId": { "type": "string", "minLength": 1 },
            "result": { "enum": ["observed", "not-observed"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scope",
            "artifact",
            "digest",
            "activity",
            "kind",
            "nodeIds",
            "traceIds",
            "result"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "scope": { "$ref": "#/$defs/scope" },
            "artifact": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
            },
            "digest": { "type": "string", "minLength": 1, "pattern": "^[a-f0-9]{64}$" },
            "activity": { "$ref": "#/$defs/activity" },
            "kind": { "const": "observation" },
            "nodeIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "traceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "result": { "enum": ["captured", "partial", "unavailable"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scope",
            "artifact",
            "digest",
            "activity",
            "kind",
            "result",
            "releasedIds",
            "remainingOwnedIds"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "scope": { "$ref": "#/$defs/scope" },
            "artifact": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
            },
            "digest": { "type": "string", "minLength": 1, "pattern": "^[a-f0-9]{64}$" },
            "activity": { "$ref": "#/$defs/activity" },
            "kind": { "const": "cleanup" },
            "result": { "enum": ["released", "failed"] },
            "releasedIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "remainingOwnedIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "catalogDigest"],
          "properties": {
            "kind": { "const": "project" },
            "revision": { "type": "string", "minLength": 1 },
            "catalogDigest": { "type": "string", "minLength": 1, "pattern": "^[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "catalogDigest", "capsuleId", "attemptId"],
          "properties": {
            "kind": { "const": "capsule" },
            "revision": { "type": "string", "minLength": 1 },
            "catalogDigest": { "type": "string", "minLength": 1, "pattern": "^[a-f0-9]{64}$" },
            "capsuleId": { "type": "string", "minLength": 1 },
            "attemptId": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "activity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "recorded" },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "not-applicable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "processResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "code"],
          "properties": {
            "kind": { "const": "exited" },
            "code": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "signal"],
          "properties": {
            "kind": { "const": "signaled" },
            "signal": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "tool-failed" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
