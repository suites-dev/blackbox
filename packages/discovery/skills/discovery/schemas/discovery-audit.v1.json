{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blackbox:skills:discovery-audit:1",
  "title": "Blackbox discovery-audit v1",
  "$ref": "#/$defs/audit",
  "$defs": {
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "mode",
        "task",
        "project",
        "catalog",
        "approvals",
        "evidence",
        "graph",
        "boundary",
        "environment",
        "execution",
        "stages",
        "operability",
        "outcome",
        "limitations",
        "nextActions"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "discovery-audit" },
        "mode": { "enum": ["initial", "reconcile"] },
        "task": { "$ref": "#/$defs/task" },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 }
          }
        },
        "catalog": { "$ref": "#/$defs/catalog" },
        "approvals": {
          "type": "array",
          "items": { "$ref": "#/$defs/approval" },
          "minItems": 0,
          "maxItems": 10000
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" },
          "minItems": 0,
          "maxItems": 10000
        },
        "graph": { "$ref": "#/$defs/graph" },
        "boundary": { "$ref": "#/$defs/boundary" },
        "environment": {
          "type": "array",
          "items": { "$ref": "#/$defs/environment" },
          "minItems": 0,
          "maxItems": 10000
        },
        "execution": { "$ref": "#/$defs/execution" },
        "stages": { "$ref": "#/$defs/stages" },
        "operability": { "$ref": "#/$defs/operability" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 0,
          "maxItems": 10000
        },
        "nextActions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 0,
          "maxItems": 10000
        }
      }
    },
    "task": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "inventory" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "preflight" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "claim"],
          "properties": { "kind": { "const": "exercise" }, "claim": { "$ref": "#/$defs/claim" } }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "acceptedBy",
        "predicate",
        "entryIds",
        "terminalIds",
        "requiredObservationIds",
        "businessId",
        "timeoutMs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "acceptedBy": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "entryIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "terminalIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "requiredObservationIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "businessId": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "catalog": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "absent" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entryId", "schemaId", "digest"],
          "properties": {
            "kind": { "const": "selected" },
            "entryId": { "type": "string", "minLength": 1 },
            "schemaId": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "minLength": 1, "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "approval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "action", "scope", "requestedAt", "kind", "approvedBy", "expiresAt"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "action": {
              "enum": [
                "read-repository",
                "fetch-remote",
                "execute-code",
                "manage-local-resources",
                "write-project",
                "write-ci",
                "access-external-service",
                "substitute-dependency"
              ]
            },
            "scope": { "type": "string", "minLength": 1 },
            "requestedAt": { "type": "string", "minLength": 1 },
            "kind": { "const": "approved" },
            "approvedBy": { "type": "string", "minLength": 1 },
            "expiresAt": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "action", "scope", "requestedAt", "kind", "reason"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "action": {
              "enum": [
                "read-repository",
                "fetch-remote",
                "execute-code",
                "manage-local-resources",
                "write-project",
                "write-ci",
                "access-external-service",
                "substitute-dependency"
              ]
            },
            "scope": { "type": "string", "minLength": 1 },
            "requestedAt": { "type": "string", "minLength": 1 },
            "kind": { "const": "denied" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "action", "scope", "requestedAt", "kind", "reason"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "action": {
              "enum": [
                "read-repository",
                "fetch-remote",
                "execute-code",
                "manage-local-resources",
                "write-project",
                "write-ci",
                "access-external-service",
                "substitute-dependency"
              ]
            },
            "scope": { "type": "string", "minLength": 1 },
            "requestedAt": { "type": "string", "minLength": 1 },
            "kind": { "const": "pending" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "repository", "revision", "path", "locator", "assertion"],
          "properties": {
            "kind": { "const": "source" },
            "id": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
            },
            "locator": { "type": "string", "minLength": 1 },
            "assertion": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "assertion", "basedOn", "reason"],
          "properties": {
            "kind": { "const": "inference" },
            "id": { "type": "string", "minLength": 1 },
            "assertion": { "type": "string", "minLength": 1 },
            "basedOn": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "assertion", "receiptId"],
          "properties": {
            "kind": { "const": "runtime" },
            "id": { "type": "string", "minLength": 1 },
            "assertion": { "type": "string", "minLength": 1 },
            "receiptId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "assertion", "reason"],
          "properties": {
            "kind": { "const": "unresolved" },
            "id": { "type": "string", "minLength": 1 },
            "assertion": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" },
          "minItems": 0,
          "maxItems": 10000
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" },
          "minItems": 0,
          "maxItems": 10000
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "ownership",
            "lifecycle",
            "relevance",
            "evidenceIds",
            "kind",
            "runtime",
            "service"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "ownership": { "enum": ["project", "organization", "third-party", "unknown"] },
            "lifecycle": { "enum": ["capsule-owned", "preexisting", "external", "unknown"] },
            "relevance": { "enum": ["required", "candidate", "excluded"] },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "participant" },
            "runtime": { "type": "string", "minLength": 1 },
            "service": { "$ref": "#/$defs/binding" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "ownership",
            "lifecycle",
            "relevance",
            "evidenceIds",
            "kind",
            "resourceType",
            "protocol"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "ownership": { "enum": ["project", "organization", "third-party", "unknown"] },
            "lifecycle": { "enum": ["capsule-owned", "preexisting", "external", "unknown"] },
            "relevance": { "enum": ["required", "candidate", "excluded"] },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "resource" },
            "resourceType": { "type": "string", "minLength": 1 },
            "protocol": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "ownership",
            "lifecycle",
            "relevance",
            "evidenceIds",
            "kind",
            "language",
            "path"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "ownership": { "enum": ["project", "organization", "third-party", "unknown"] },
            "lifecycle": { "enum": ["capsule-owned", "preexisting", "external", "unknown"] },
            "relevance": { "enum": ["required", "candidate", "excluded"] },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "module" },
            "language": { "type": "string", "minLength": 1 },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "ownership",
            "lifecycle",
            "relevance",
            "evidenceIds",
            "kind",
            "ecosystem",
            "version"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "ownership": { "enum": ["project", "organization", "third-party", "unknown"] },
            "lifecycle": { "enum": ["capsule-owned", "preexisting", "external", "unknown"] },
            "relevance": { "enum": ["required", "candidate", "excluded"] },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "package" },
            "ecosystem": { "type": "string", "minLength": 1 },
            "version": { "$ref": "#/$defs/binding" }
          }
        }
      ]
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "resolved" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unresolved" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "edge": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "from", "to", "evidenceIds", "kind", "protocol", "operation"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "behavioral" },
            "protocol": { "type": "string", "minLength": 1 },
            "operation": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "from",
            "to",
            "evidenceIds",
            "kind",
            "phase",
            "necessity",
            "condition"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "requires" },
            "phase": { "enum": ["build", "startup", "execution", "observation", "cleanup"] },
            "necessity": { "enum": ["mandatory", "conditional", "unknown"] },
            "condition": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "from", "to", "evidenceIds", "kind", "relation"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "deployment" },
            "relation": { "enum": ["colocated", "connected", "exposed"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "from", "to", "evidenceIds", "kind", "relation"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "source" },
            "relation": { "enum": ["imports", "calls", "depends-on-package", "implements"] }
          }
        }
      ]
    },
    "boundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unselected" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nodeIds",
            "excluded",
            "substitutions",
            "unresolvedRequiredIds",
            "rationale",
            "confidence"
          ],
          "properties": {
            "kind": { "const": "selected" },
            "nodeIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nodeId", "reason"],
                "properties": {
                  "nodeId": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              },
              "minItems": 0,
              "maxItems": 10000
            },
            "substitutions": {
              "type": "array",
              "items": { "$ref": "#/$defs/substitution" },
              "minItems": 0,
              "maxItems": 10000
            },
            "unresolvedRequiredIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "rationale": { "type": "string", "minLength": 1 },
            "confidence": { "$ref": "#/$defs/confidence" }
          }
        }
      ]
    },
    "substitution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "replacement", "approvalId", "preserves", "limitations"],
      "properties": {
        "original": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string", "minLength": 1 },
        "approvalId": { "type": "string", "minLength": 1 },
        "preserves": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "maxItems": 10000
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "maxItems": 10000
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reasons", "evidenceIds"],
      "properties": {
        "kind": { "enum": ["unknown", "low", "medium", "high"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "maxItems": 10000
        },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        }
      }
    },
    "environment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "evidenceIds", "consumers", "kind", "source", "availability"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "consumers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "configuration" },
            "source": { "type": "string", "minLength": 1 },
            "availability": { "enum": ["present", "missing", "unknown"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "evidenceIds", "consumers", "kind", "reference", "availability"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "consumers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "secret-reference" },
            "reference": { "type": "string", "minLength": 1 },
            "availability": { "enum": ["present", "missing", "unknown"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "evidenceIds", "consumers", "kind", "reason"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "consumers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "kind": { "const": "unknown" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "not-run" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "capsuleId", "attemptId", "activityIds"],
          "properties": {
            "kind": { "const": "capsule" },
            "capsuleId": { "type": "string", "minLength": 1 },
            "attemptId": { "type": "string", "minLength": 1 },
            "activityIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "acquisition",
        "readiness",
        "setup",
        "stimulus",
        "terminal",
        "observation",
        "cleanup"
      ],
      "properties": {
        "catalog": { "$ref": "#/$defs/stage" },
        "acquisition": { "$ref": "#/$defs/stage" },
        "readiness": { "$ref": "#/$defs/stage" },
        "setup": { "$ref": "#/$defs/stage" },
        "stimulus": { "$ref": "#/$defs/stage" },
        "terminal": { "$ref": "#/$defs/stage" },
        "observation": { "$ref": "#/$defs/stage" },
        "cleanup": { "$ref": "#/$defs/stage" }
      }
    },
    "stage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "not-run" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "not-required" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "blocked" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason", "receiptIds"],
          "properties": {
            "kind": { "const": "failed" },
            "reason": { "type": "string", "minLength": 1 },
            "receiptIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "receiptIds"],
          "properties": {
            "kind": { "const": "passed" },
            "receiptIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "operability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "not-assessed" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "claimId"],
          "properties": {
            "kind": { "const": "operable" },
            "claimId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "inoperable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "inconclusive" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "complete" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reasons"],
          "properties": {
            "kind": { "enum": ["incomplete", "blocked", "failed"] },
            "reasons": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "maxItems": 10000
            }
          }
        }
      ]
    }
  }
}
