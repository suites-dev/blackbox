{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suites.dev/blackbox/schemas/capsule-operational-report-v1.json",
  "title": "Blackbox Capsule operational report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "session",
    "lifecycle",
    "composeProject",
    "entrypoint",
    "resources",
    "readiness",
    "activities",
    "progress",
    "observations",
    "cleanup",
    "failure",
    "redactions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "capsule-operational-report" },
    "session": { "$ref": "#/$defs/reportSession" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "composeProject": { "$ref": "#/$defs/stringAvailability" },
    "entrypoint": { "$ref": "#/$defs/entrypointAvailability" },
    "resources": { "$ref": "#/$defs/resources" },
    "readiness": { "$ref": "#/$defs/readinessAvailability" },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "https://suites.dev/blackbox/schemas/capsule-activities-v1.json#/$defs/activity"
      }
    },
    "progress": {
      "type": "array",
      "items": {
        "$ref": "https://suites.dev/blackbox/schemas/capsule-progress-v1.json#/properties/events/items"
      }
    },
    "observations": { "$ref": "#/$defs/observations" },
    "cleanup": {
      "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/cleanup"
    },
    "failure": {
      "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/failure"
    },
    "redactions": { "$ref": "#/$defs/redactions" }
  },
  "$defs": {
    "reportSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "system",
        "title",
        "description",
        "retainedState",
        "admittedAt",
        "updatedAt",
        "artifactRoot"
      ],
      "properties": {
        "sessionId": { "type": "string" },
        "system": { "type": "string" },
        "title": { "type": "string" },
        "description": {
          "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/description"
        },
        "retainedState": {
          "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/sessionState"
        },
        "admittedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "artifactRoot": { "type": "string" }
      }
    },
    "lifecycle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "retainedState"],
          "properties": {
            "kind": { "const": "running" },
            "retainedState": { "const": "running" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "retainedState"],
          "properties": {
            "kind": { "const": "starting" },
            "retainedState": {
              "enum": ["admitted", "manager-starting", "sandbox-starting"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "retainedState"],
          "properties": {
            "kind": { "const": "stopping" },
            "retainedState": { "const": "stopping" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "retainedState"],
          "properties": {
            "kind": { "const": "stopped" },
            "retainedState": { "const": "stopped" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "retainedState"],
          "properties": {
            "kind": { "const": "failed" },
            "retainedState": {
              "enum": ["start-failed", "manager-failed", "stop-failed"]
            }
          }
        }
      ]
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "unavailable" } }
    },
    "stringAvailability": {
      "oneOf": [
        { "$ref": "#/$defs/unavailable" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "available" },
            "value": { "type": "string" }
          }
        }
      ]
    },
    "entrypointAvailability": {
      "oneOf": [
        { "$ref": "#/$defs/unavailable" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "available" },
            "value": {
              "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/entrypoint"
            }
          }
        }
      ]
    },
    "readinessAvailability": {
      "oneOf": [
        { "$ref": "#/$defs/unavailable" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "available" },
            "value": {
              "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/readiness"
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containers", "networks", "volumes"],
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/container"
          }
        },
        "networks": {
          "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/stringArray"
        },
        "volumes": {
          "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/stringArray"
        }
      }
    },
    "observations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "telemetry",
            "fragmentCount",
            "traceIds",
            "activations"
          ],
          "properties": {
            "kind": { "const": "collector-session-found" },
            "telemetry": { "$ref": "#/$defs/telemetry" },
            "fragmentCount": { "type": "number" },
            "traceIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "activations": {
              "type": "array",
              "items": { "$ref": "#/$defs/activation" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message"],
          "properties": {
            "kind": { "const": "collector-session-missing" },
            "message": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "error"],
          "properties": {
            "kind": { "const": "collector-session-corrupt" },
            "error": {
              "$ref": "https://suites.dev/blackbox/schemas/capsule-session-v1.json#/$defs/recordedError"
            }
          }
        }
      ]
    },
    "telemetry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "acceptedRequests", "acceptedSpans", "lastReceivedAt"],
          "properties": {
            "status": { "const": "not-received" },
            "acceptedRequests": { "const": 0 },
            "acceptedSpans": { "const": 0 },
            "lastReceivedAt": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "acceptedRequests", "acceptedSpans", "lastReceivedAt"],
          "properties": {
            "status": { "const": "received" },
            "acceptedRequests": { "type": "number" },
            "acceptedSpans": { "type": "number" },
            "lastReceivedAt": { "type": "string" }
          }
        }
      ]
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "serviceName", "activatedAt"],
      "properties": {
        "runtime": { "type": "string" },
        "serviceName": { "type": "string" },
        "activatedAt": { "type": "string" }
      }
    },
    "redactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "entries"],
      "properties": {
        "count": { "type": "number" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "location"],
            "properties": {
              "kind": {
                "enum": [
                  "authorization-credential",
                  "environment-value",
                  "sensitive-argument",
                  "sensitive-header",
                  "sensitive-output",
                  "private-ipc-path"
                ]
              },
              "location": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
