{
  "name": "@suites/blackbox-capsule",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "description": "Persistent Capsule session manager over Catalog and Sandbox.",
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.fixture.*",
    "!src/**/testing/**",
    "!src/**/test-fixtures/**",
    "!src/**/__tests__/**"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "blackbox-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema/capsule-progress-v1.json": "./schema/capsule-progress-v1.json",
    "./schema/capsule-session-v1.json": "./schema/capsule-session-v1.json",
    "./schema/capsule-activities-v1.json": "./schema/capsule-activities-v1.json",
    "./schema/capsule-operational-report-v1.json": "./schema/capsule-operational-report-v1.json"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@suites/blackbox-driver": "workspace:*",
    "@suites/blackbox-catalog": "workspace:*",
    "@suites/blackbox-instrumentation": "workspace:*",
    "@suites/blackbox-otel-collector": "workspace:*",
    "@suites/blackbox-sandbox": "workspace:*",
    "@suites/blackbox-telemetry": "workspace:*",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suites-dev/blackbox.git",
    "directory": "packages/capsule"
  },
  "homepage": "https://github.com/suites-dev/blackbox/tree/main/packages/capsule#readme",
  "bugs": {
    "url": "https://github.com/suites-dev/blackbox/issues"
  },
  "author": "Suites"
}
