    "lint": "eslint .",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suites-dev/blackbox.git",
    "directory": "packages/cli-contract"
  },
  "homepage": "https://github.com/suites-dev/blackbox/tree/main/packages/cli-contract#readme",
  "bugs": {
    "url": "https://github.com/suites-dev/blackbox/issues"
