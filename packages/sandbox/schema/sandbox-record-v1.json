{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.suites.dev/blackbox/sandbox-record/v1",
  "title": "Blackbox durable sandbox record v1",
  "oneOf": [
    { "$ref": "#/$defs/activeRecord" },
    { "$ref": "#/$defs/completedRecord" },
    { "$ref": "#/$defs/startFailedRecord" },
    { "$ref": "#/$defs/stopFailedRecord" }
  ],
  "$defs": {
    "baseRecord": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sandboxId",
        "projectName",
        "composeFiles",
        "state",
        "revision",
        "admittedAt",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sandboxId": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "minLength": 1 },
        "composeFiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "state": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "admittedAt": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 }
      }
    },
    "activeRecord": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "required": ["state"],
      "properties": {
        "state": { "enum": ["admitted", "starting", "running", "stopping"] }
      },
      "unevaluatedProperties": false
    },
    "completedRecord": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "required": ["state", "stopReason", "cleanup"],
      "properties": {
        "state": { "const": "completed" },
        "stopReason": {
          "enum": ["completed", "cancelled", "failed", "interrupted"]
        },
        "cleanup": { "const": "complete" }
      },
      "unevaluatedProperties": false
    },
    "startFailedRecord": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "required": ["state", "primaryError", "cleanup"],
      "properties": {
        "state": { "const": "start-failed" },
        "primaryError": { "$ref": "#/$defs/error" },
        "cleanup": { "$ref": "#/$defs/cleanupRecord" }
      },
      "unevaluatedProperties": false
    },
    "stopFailedRecord": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "required": ["state", "primaryError", "cleanup"],
      "properties": {
        "state": { "const": "stop-failed" },
        "primaryError": { "$ref": "#/$defs/error" },
        "cleanup": { "$ref": "#/$defs/failedCleanup" }
      },
      "unevaluatedProperties": false
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "message"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "cleanupRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "not-attempted" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "complete" } }
        },
        { "$ref": "#/$defs/failedCleanup" }
      ]
    },
    "failedCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "error"],
      "properties": {
        "kind": { "const": "failed" },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  }
}
