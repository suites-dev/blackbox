{
  "name": "@suites/blackbox",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "description": "Blackbox system verification: core module composition and agent entry skill.",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "blackbox-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./module": {
      "blackbox-source": "./src/module.ts",
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    "./skills": {
      "blackbox-source": "./src/skills.ts",
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "default": "./dist/skills.js"
    },
    "./skills/blackbox": {
      "blackbox-source": "./src/skills.ts",
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "default": "./dist/skills.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@suites/blackbox-catalog": "workspace:*",
    "@suites/blackbox-cli": "workspace:*",
    "@suites/blackbox-discovery": "workspace:*",
    "@suites/blackbox-skills": "workspace:*"
  },
  "devDependencies": {
    "@suites/blackbox-cli-contract": "workspace:*",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "blackbox": {
    "module": {
      "apiVersion": 1,
      "export": "./module"
    },
    "skills": {
      "apiVersion": 1,
      "export": "./skills"
    }
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suites-dev/blackbox.git",
    "directory": "packages/blackbox"
  },
  "homepage": "https://github.com/suites-dev/blackbox/tree/main/packages/blackbox#readme",
  "bugs": {
    "url": "https://github.com/suites-dev/blackbox/issues"
  },
  "author": "Suites"
}
