{
  "name": "@suites/blackbox-driver",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "description": "Language-neutral Blackbox command driver contract and Node authoring SDK.",
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.fixture.*",
    "!src/**/testing/**",
    "!src/**/test-fixtures/**",
    "!src/**/__tests__/**"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "blackbox-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node-runner": {
      "blackbox-source": "./src/node-runner/index.ts",
      "types": "./dist/node-runner/index.d.ts",
      "import": "./dist/node-runner/index.js",
      "default": "./dist/node-runner/index.js"
    },
    "./schema/driver-prepare-request-v1.json": "./schema/driver-prepare-request-v1.json",
    "./schema/driver-prepare-response-v1.json": "./schema/driver-prepare-response-v1.json",
    "./schema/driver-runtime-v1.json": "./schema/driver-runtime-v1.json"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "pretest": "pnpm build",
    "test": "vitest run --config vitest.config.ts"
  },
  "blackbox": {
    "cli": {
      "apiVersion": 1,
      "pluginId": "driver",
      "topic": "driver"
    }
  },
  "oclif": {
    "commands": {
      "strategy": "explicit",
      "target": "./dist/cli/command-registry.js",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " ",
    "topics": {
      "driver": {
        "description": "Install the project-owned driver runtime."
      }
    }
  },
  "dependencies": {
    "@oclif/core": "^5.1.0",
    "@suites/blackbox-cli-contract": "workspace:*",
    "@suites/blackbox-telemetry": "workspace:*",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suites-dev/blackbox.git",
    "directory": "packages/driver"
  },
  "homepage": "https://github.com/suites-dev/blackbox/tree/main/packages/driver#readme",
  "bugs": {
    "url": "https://github.com/suites-dev/blackbox/issues"
  },
  "author": "Suites"
}
