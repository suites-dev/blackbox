{
  "name": "@suites/blackbox-otel-collector",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "description": "Capsule-scoped OTLP/HTTP JSON trace receiver and retained trace reader.",
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.fixture.*",
    "!src/**/testing/**",
    "!src/**/test-fixtures/**",
    "!src/**/__tests__/**"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "blackbox-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema/collector-fragment-v1.json": "./schema/collector-fragment-v1.json",
    "./schema/collector-activation-v1.json": "./schema/collector-activation-v1.json",
    "./schema/collector-lifecycle-v1.json": "./schema/collector-lifecycle-v1.json"
  },
  "bin": {
    "blackbox-otel-collector": "./dist/main.js"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suites-dev/blackbox.git",
    "directory": "packages/otel-collector"
  },
  "homepage": "https://github.com/suites-dev/blackbox/tree/main/packages/otel-collector#readme",
  "bugs": {
    "url": "https://github.com/suites-dev/blackbox/issues"
  },
  "author": "Suites"
}
