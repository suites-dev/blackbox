{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.suites.dev/blackbox/collector-activation-v1.json",
  "title": "Blackbox collector instrumentation activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sessionId",
    "executionId",
    "runtime",
    "serviceName"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "instrumentation-activation-v1" },
    "sessionId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "serviceName": { "type": "string", "minLength": 1 }
  }
}
