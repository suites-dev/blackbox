{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.fixture.ts",
    "**/testing/**",
    "**/test-fixtures/**",
    "dist",
    "node_modules",
    "test-results"
  ]
}
