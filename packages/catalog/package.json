{
  "name": "@suites/blackbox-catalog",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "description": "YAML catalog schema, validation, selection, and sandbox-input resolution.",
  "files": [
    "dist",
    "skills",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.fixture.*",
    "!src/**/testing/**",
    "!src/**/test-fixtures/**",
    "!src/**/__tests__/**"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "blackbox-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema/blackbox-config-v1.json": "./schema/blackbox-config-v1.json",
    "./skills": {
      "blackbox-source": "./src/skills.ts",
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "default": "./dist/skills.js"
    },
    "./skills/catalog": {
      "blackbox-source": "./src/skills.ts",
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "default": "./dist/skills.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts"
  },
  "blackbox": {
    "cli": {
      "apiVersion": 1,
      "pluginId": "catalog",
      "topic": "catalog"
    },
    "skills": {
      "apiVersion": 1,
      "export": "./skills"
    }
  },
  "oclif": {
    "commands": {
      "strategy": "explicit",
      "target": "./dist/cli/command-registry.js",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " "
  },
  "dependencies": {
    "@oclif/core": "^5.1.0",
    "@suites/blackbox-cli-contract": "workspace:*",
    "@suites/blackbox-skills": "workspace:*",
    "@suites/blackbox-telemetry": "workspace:*",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suites-dev/blackbox.git",
    "directory": "packages/catalog"
  },
  "homepage": "https://github.com/suites-dev/blackbox/tree/main/packages/catalog#readme",
  "bugs": {
    "url": "https://github.com/suites-dev/blackbox/issues"
  },
  "author": "Suites"
}
