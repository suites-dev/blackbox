{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suites-dev/blackbox/packages/effects/schema/effects-record-v0.json",
  "title": "Blackbox effects record (experimental v0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "completeness", "effects"],
  "properties": {
    "schemaVersion": {
      "const": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["playwright-attempt", "capsule-activity"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "completeness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "enum": ["provisional", "complete"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {
              "const": "incomplete"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "operation", "target", "outcome", "count"],
        "properties": {
          "kind": {
            "enum": ["http", "rpc", "db", "cache", "message", "business", "internal", "unknown"]
          },
          "operation": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
