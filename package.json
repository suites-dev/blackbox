{
  "name": "suites-blackbox-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Suites",
  "description": "Monorepo for Suites Blackbox.",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "test": "pnpm run build && pnpm --recursive --if-present run test",
    "lint": "eslint packages --cache",
    "lint:fix": "eslint packages --cache --fix",
    "typecheck": "pnpm run build",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" package.json pnpm-workspace.yaml",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --no-warn-ignored"
    ]
  }
}
