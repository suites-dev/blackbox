{
  "schemaVersion": 2,
  "policyId": "e2e-all-participants-v1",
  "instrumentation": {
    "provider": "opentelemetry-node",
    "version": "0.55.3",
    "captureMode": "zero-code"
  },
  "boundarySemantics": {
    "authoritativeFor": "Facts this boundary is eligible to prove when its instrumentation is qualified.",
    "requiredBoundaries": "Instrumentation that must be healthy for the entire run, including scenarios where the correct matching-effect count is zero."
  },
  "boundaries": [
    {
      "id": "effects.http",
      "kind": "http",
      "authoritativeFor": [
        "normalized inbound and outbound HTTP effects"
      ]
    },
    {
      "id": "effects.postgres",
      "kind": "postgres",
      "authoritativeFor": [
        "normalized PostgreSQL statement effects"
      ]
    },
    {
      "id": "effects.redis",
      "kind": "redis",
      "authoritativeFor": [
        "normalized Redis command effects"
      ]
    },
    {
      "id": "effects.sqs",
      "kind": "sqs",
      "authoritativeFor": [
        "normalized SQS messaging effects"
      ]
    }
  ],
  "redaction": {
    "requestBodies": "not-captured",
    "headers": [
      "authorization",
      "cookie",
      "set-cookie"
    ],
    "dynamicIdentifiers": "normalized in effect identities and paths"
  },
  "completeness": {
    "requiredBoundaries": [
      "effects.http",
      "effects.postgres",
      "effects.redis",
      "effects.sqs"
    ],
    "terminalObservationWindowMs": 5000,
    "participantCoverage": "all-resolved-participants"
  }
}
